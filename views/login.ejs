<%- include('_head', { title: 'Log in' }) %>
<div class="max-w-sm mx-auto bg-white rounded-lg shadow p-6 mt-10">
  <h1 class="text-xl font-semibold mb-4">Log in to StockFlow</h1>
  <form method="post" action="/login" class="space-y-3">
    <label class="block text-sm">Email<input type="email" name="email" required value="<%= v.email || '' %>" class="mt-1 w-full border rounded px-3 py-2"></label>
    <label class="block text-sm">Password<input type="password" name="password" required class="mt-1 w-full border rounded px-3 py-2"></label>
    <button class="w-full bg-indigo-600 text-white rounded py-2 hover:bg-indigo-700">Log in</button>
  </form>
  <p class="text-sm text-slate-500 mt-4">No account? <a href="/signup" class="text-indigo-600">Sign up</a></p>
</div>
<%- include('_foot') %>
