<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>StockFlow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">
<% if (user) { %>
<nav class="bg-white border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-6">
    <a href="/" class="font-bold text-indigo-600 text-lg">StockFlow</a>
    <a href="/" class="text-sm hover:text-indigo-600">Dashboard</a>
    <a href="/products" class="text-sm hover:text-indigo-600">Products</a>
    <a href="/settings" class="text-sm hover:text-indigo-600">Settings</a>
    <span class="ml-auto text-xs text-slate-500 hidden sm:block"><%= user.org_name %> · <%= user.email %></span>
    <form method="post" action="/logout"><button class="text-sm text-slate-600 hover:text-red-600">Log out</button></form>
  </div>
</nav>
<% } %>
<main class="max-w-5xl mx-auto px-4 py-8">
<% if (msg) { %><div class="mb-4 rounded bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm px-3 py-2"><%= msg %></div><% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %>
  <div class="mb-4 rounded bg-red-50 border border-red-200 text-red-800 text-sm px-3 py-2">
    <ul class="list-disc pl-5"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>
