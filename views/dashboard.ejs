<%- include('_head', { title: 'Dashboard' }) %>
<h1 class="text-2xl font-semibold mb-6">Dashboard</h1>
<div class="grid sm:grid-cols-2 gap-4 mb-8">
  <div class="bg-white rounded-lg shadow p-5"><div class="text-sm text-slate-500">Total products</div><div class="text-3xl font-bold" id="total-products"><%= totals.n %></div></div>
  <div class="bg-white rounded-lg shadow p-5"><div class="text-sm text-slate-500">Total units on hand</div><div class="text-3xl font-bold" id="total-units"><%= totals.units %></div></div>
</div>
<h2 class="text-lg font-semibold mb-3">Low stock items</h2>
<div class="bg-white rounded-lg shadow overflow-x-auto">
<% if (!low.length) { %>
  <p class="p-5 text-sm text-slate-500">No low stock items. 🎉</p>
<% } else { %>
  <table class="w-full text-sm">
    <thead class="bg-slate-100 text-left"><tr><th class="p-3">Name</th><th class="p-3">SKU</th><th class="p-3">Quantity on hand</th><th class="p-3">Low stock threshold</th></tr></thead>
    <tbody>
    <% low.forEach(p => { %>
      <tr class="border-t"><td class="p-3"><a class="text-indigo-600" href="/products/<%= p.id %>/edit"><%= p.name %></a></td><td class="p-3"><%= p.sku %></td>
      <td class="p-3 font-semibold text-red-600"><%= p.quantity %></td><td class="p-3"><%= p.eff_threshold %><%= p.low_stock_threshold === null ? ' (default)' : '' %></td></tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
</div>
<%- include('_foot') %>
