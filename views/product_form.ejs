<%- include('_head') %>
<div class="max-w-xl bg-white rounded-lg shadow p-6">
  <h1 class="text-xl font-semibold mb-4"><%= title %></h1>
  <form method="post" action="<%= action %>" class="space-y-3">
    <label class="block text-sm">Name *<input name="name" required value="<%= v.name ?? '' %>" class="mt-1 w-full border rounded px-3 py-2"></label>
    <label class="block text-sm">SKU * (unique in your organization)<input name="sku" required value="<%= v.sku ?? '' %>" class="mt-1 w-full border rounded px-3 py-2"></label>
    <label class="block text-sm">Description<textarea name="description" rows="2" class="mt-1 w-full border rounded px-3 py-2"><%= v.description ?? '' %></textarea></label>
    <div class="grid grid-cols-2 gap-3">
      <label class="block text-sm">Quantity on hand *<input name="quantity" type="number" min="0" step="1" required value="<%= v.quantity ?? 0 %>" class="mt-1 w-full border rounded px-3 py-2"></label>
      <label class="block text-sm">Low stock threshold<input name="low_stock_threshold" type="number" min="0" step="1" value="<%= v.low_stock_threshold ?? '' %>" placeholder="Uses default" class="mt-1 w-full border rounded px-3 py-2"></label>
      <label class="block text-sm">Cost price<input name="cost_price" type="number" min="0" step="0.01" value="<%= v.cost_price ?? '' %>" class="mt-1 w-full border rounded px-3 py-2"></label>
      <label class="block text-sm">Selling price<input name="selling_price" type="number" min="0" step="0.01" value="<%= v.selling_price ?? '' %>" class="mt-1 w-full border rounded px-3 py-2"></label>
    </div>
    <% if (typeof meta !== 'undefined' && meta) { %>
      <p class="text-xs text-slate-500">Last updated <%= meta.updated_at %> UTC by <%= meta.last_updated_by || '—' %></p>
    <% } %>
    <div class="flex gap-3 pt-2">
      <button class="bg-indigo-600 text-white rounded px-4 py-2 hover:bg-indigo-700">Save</button>
      <a href="/products" class="px-4 py-2 text-slate-600">Cancel</a>
    </div>
  </form>
</div>
<%- include('_foot') %>
