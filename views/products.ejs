<%- include('_head', { title: 'Products' }) %>
<div class="flex flex-wrap items-center gap-3 mb-4">
  <h1 class="text-2xl font-semibold">Products</h1>
  <form method="get" action="/products" class="ml-auto flex gap-2">
    <input name="q" value="<%= q %>" placeholder="Search name or SKU" class="border rounded px-3 py-1.5 text-sm">
    <button class="border rounded px-3 py-1.5 text-sm bg-white hover:bg-slate-100">Search</button>
  </form>
  <a href="/products/new" class="bg-indigo-600 text-white text-sm rounded px-4 py-2 hover:bg-indigo-700">+ Add product</a>
</div>
<div class="bg-white rounded-lg shadow overflow-x-auto">
<% if (!products.length) { %>
  <p class="p-5 text-sm text-slate-500"><%= q ? 'No products match your search.' : 'No products yet. Add your first one!' %></p>
<% } else { %>
  <table class="w-full text-sm">
    <thead class="bg-slate-100 text-left"><tr><th class="p-3">Name</th><th class="p-3">SKU</th><th class="p-3">Quantity</th><th class="p-3">Status</th><th class="p-3">Selling price</th><th class="p-3">Adjust stock</th><th class="p-3"></th></tr></thead>
    <tbody>
    <% products.forEach(p => { %>
      <tr class="border-t align-middle">
        <td class="p-3"><%= p.name %></td><td class="p-3"><%= p.sku %></td><td class="p-3"><%= p.quantity %></td>
        <td class="p-3"><% if (p.is_low) { %><span class="bg-red-100 text-red-700 text-xs px-2 py-0.5 rounded-full">Low stock</span><% } else { %><span class="bg-emerald-100 text-emerald-700 text-xs px-2 py-0.5 rounded-full">OK</span><% } %></td>
        <td class="p-3"><%= p.selling_price === null ? '—' : Number(p.selling_price).toFixed(2) %></td>
        <td class="p-3"><form method="post" action="/products/<%= p.id %>/adjust" class="flex gap-1">
          <input name="delta" placeholder="+5 / -3" class="border rounded px-2 py-1 w-20"><button class="border rounded px-2 py-1 hover:bg-slate-100">Apply</button></form></td>
        <td class="p-3 whitespace-nowrap">
          <a href="/products/<%= p.id %>/edit" class="text-indigo-600 mr-3">Edit</a>
          <form method="post" action="/products/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Delete this product? This cannot be undone.')">
            <button class="text-red-600">Delete</button></form></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
</div>
<%- include('_foot') %>
